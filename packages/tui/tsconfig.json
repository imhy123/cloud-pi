{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@oh-my-pi/pi-utils": [
				"../vendor/omp/pi-utils/src/index.ts"
			],
			"@oh-my-pi/pi-utils/*": [
				"../vendor/omp/pi-utils/src/*"
			],
			"@oh-my-pi/pi-natives": [
				"./src/compat/natives.ts"
			],
			"@oh-my-pi/pi-natives/path": [
				"../vendor/omp/pi-utils/src/natives-path.ts"
			],
			"@oh-my-pi/pi-ai": [
				"./src/compat/pi-ai.ts"
			],
			"@oh-my-pi/pi-agent-core": [
				"./src/compat/pi-agent-core.ts"
			]
		}
	},
	"include": [
		"src",
		"entries",
		"test",
		"tsup.config.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
